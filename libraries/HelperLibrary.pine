    once ( isInPeriod or (hasTradingWeekChanged() and isBarInLookBackWindow("W", 4 + 1)) )
        isInPeriod := true
    isInPeriod


export isBarInCurrentTradingMonth() =>
    varip int timeClose = nz(time_close("1M"))
    if ( barstate.isnew and ((timeClose == 0) or ((timeClose <= last_bar_time) and hasTradingMonthChanged())) )
        timeClose := nz(time_close("1M"))
    (timeClose > last_bar_time)


export isBarInLast_1_TradingMonth() =>
