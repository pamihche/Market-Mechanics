export isBarInCurrentTradingYear() =>
    varip int timeClose = nz(time_close("12M"))
    if ( barstate.isnew and ((timeClose == 0) or ((timeClose <= last_bar_time) and hasTradingYearChanged())) )
        timeClose := nz(time_close("12M"))
