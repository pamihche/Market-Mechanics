//====================================================================
// ARRAY SET OPERATIONS
//====================================================================

export method intersectArrays(array<int> firstArray, array<int> secondArray, array<int> thirdArray = na, bool sortOutput = false, bool sortAscending = true) =>
    int        firstSize     = firstArray.size()
    int        secondSize    = secondArray.size()
    int        thirdSize     = not( na(thirdArray) ) ? thirdArray.size() : 0
    bool       hasThirdArray = (thirdSize > 0)
    array<int> outputArray   = array.new<int>()

    if ( (firstSize > 0) and (secondSize > 0) )
        map<int, int> lookupMap = map.new<int, int>()
        bool firstIsGreater     = (firstSize > secondSize)
        for value in (firstIsGreater ? firstArray : secondArray)
            lookupMap.put(value, 1)

        if ( not( hasThirdArray ) )
            for value in (firstIsGreater ? secondArray : firstArray)
                if ( lookupMap.get(value) == 1 )
                    lookupMap.put(value, 2)
                    outputArray.push(value)
        else
            for value in (firstIsGreater ? secondArray : firstArray)
                if ( lookupMap.get(value) == 1 )
                    lookupMap.put(value, 2)
            for value in thirdArray
                if ( lookupMap.get(value) == 2 )
                    lookupMap.put(value, 3)
                    outputArray.push(value)

        if ( sortOutput )
            outputArray.sort(sortAscending ? order.ascending : order.descending)
    outputArray


export method arrayDifference(array<int> firstArray, array<int> secondArray, array<int> thirdArray = na, bool sortOutput = false, bool sortAscending = true) =>
    int        firstSize     = firstArray.size()
    int        secondSize    = secondArray.size()
    int        thirdSize     = not( na(thirdArray) ) ? thirdArray.size() : 0
    bool       hasThirdArray = (thirdSize > 0)
    array<int> outputArray   = array.new<int>()

    if ( firstSize > 0 )
        if ( (firstSize + secondSize + thirdSize) < 40 )
            for value in firstArray
                if ( not( secondArray.includes(value) ) and (not( hasThirdArray ) or not( thirdArray.includes(value) )) )
                    if ( not( outputArray.includes(value) ) )
                        outputArray.push(value)
        else
            map<int, int> lookupMap = map.new<int, int>()
            if ( firstSize <= (secondSize + thirdSize) )
                for value in firstArray
                    lookupMap.put(value, 1)
                for value in secondArray
                    lookupMap.remove(value)
                if ( hasThirdArray )
                    for value in thirdArray
                        lookupMap.remove(value)
                outputArray := lookupMap.keys()
            else
                for value in secondArray
                    lookupMap.put(value, 1)
                if ( hasThirdArray )
                    for value in thirdArray
                        lookupMap.put(value, 1)
                for value in firstArray
                    if ( not( lookupMap.contains(value) ) and not( outputArray.includes(value) ) )
                        outputArray.push(value)

        if ( sortOutput )
            outputArray.sort(sortAscending ? order.ascending : order.descending)

    outputArray
