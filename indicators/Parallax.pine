//@version=6
indicator("Parallax", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

import MihChe/HelperLibrary/1    as HelperLib
import MihChe/AssetLibrary/1     as AssetLib
import MihChe/TimeFrameLibrary/1 as TimeFrameLib
import MihChe/CandleLibrary/1    as CandleLib
import MihChe/SwingLibrary/1     as SwingLib
import MihChe/GapLibrary/1       as GapLib
import MihChe/SmtLibrary/1       as SmtLib
import MihChe/EngineLibrary/1    as EngineLib


//====================================================================
// INPUT GROUPS & TOOLTIPS
//====================================================================

const string GRP_ASSETS      = "Correlated Assets"
const string GRP_DIVERGENCES = "Divergences"
const string GRP_PSP         = "Precision Swing Point (PSP)"

const string TT_MASTER       = "Master switch for Parallax calculations/drawings and aligned higher-timeframe divergence monitoring."
const string TT_ASSETS       = "Leave symbol empty to auto-detect the correlated triad or pair, or select a custom ticker override."
const string TT_MAX_DIV      = "Maximum active non-crossing bullish and bearish divergences displayed simultaneously (0 to 5 per side)."
const string TT_UNCONF       = "Styling applied to divergences still forming inside an unconfirmed higher-timeframe or live candle."
const string TT_PSP_ROW      = "Marks divergence vertices with opposing cross-asset candle polarity; Live Intrabar previews polarity before bar close."
const string TT_PSP_BARS     = "Highlights recent chart candles that print a Precision Swing Point at an active divergence endpoint."


//====================================================================
// INPUTS
//====================================================================

// Master Controls (Top Row)
bool inEnableIndicator = input.bool(true, "Enable Parallax", inline = "master")
bool inShowHtf         = input.bool(true, "HTF Divergences", inline = "master", tooltip = TT_MASTER, active = inEnableIndicator)

// 1. Correlated Assets
bool   inEnableSecond       = input.bool(true,   "Second Asset", inline = "asset2", group = GRP_ASSETS, active = inEnableIndicator)
string inCustomSecondSymbol = input.symbol("",   "",             inline = "asset2", group = GRP_ASSETS, tooltip = TT_ASSETS, active = ( inEnableIndicator and inEnableSecond ))

bool   inEnableThird        = input.bool(true,   "Third Asset",  inline = "asset3", group = GRP_ASSETS, active = inEnableIndicator)
string inCustomThirdSymbol  = input.symbol("",   "",             inline = "asset3", group = GRP_ASSETS, tooltip = TT_ASSETS, active = ( inEnableIndicator and inEnableThird ))

// 2. Divergences
int                  inMaxBullish       = input.int(5,                           "Max Bullish", minval = 0, maxval = 5, inline = "maxDiv",    group = GRP_DIVERGENCES, active = inEnableIndicator)
int                  inMaxBearish       = input.int(5,                           "Max Bearish", minval = 0, maxval = 5, inline = "maxDiv",    group = GRP_DIVERGENCES, tooltip = TT_MAX_DIV, active = inEnableIndicator)
bool                 inShowLabels       = input.bool(true,                       "Labels",                              inline = "divCols",   group = GRP_DIVERGENCES, active = inEnableIndicator)
color                inBullishColor     = input.color(#089981FF,                 "Bull",                                inline = "divCols",   group = GRP_DIVERGENCES, active = inEnableIndicator)
color                inBearishColor     = input.color(#F23645FF,                 "Bear",                                inline = "divCols",   group = GRP_DIVERGENCES, active = inEnableIndicator)
SmtLib.LineStyleType inConfirmedStyle   = input.enum(SmtLib.LineStyleType.Solid, "Confirmed",                           inline = "confStyle", group = GRP_DIVERGENCES, active = inEnableIndicator)
int                  inLineWidth        = input.int(2,                           "Width",       minval = 1, maxval = 4, inline = "confStyle", group = GRP_DIVERGENCES, active = inEnableIndicator)
SmtLib.LineStyleType inUnconfirmedStyle = input.enum(SmtLib.LineStyleType.Solid, "Unconfirmed",                         inline = "unconfSt",  group = GRP_DIVERGENCES, active = inEnableIndicator)
color                inUnconfirmedColor = input.color(#FF9800FF,                 "",                                    inline = "unconfSt",  group = GRP_DIVERGENCES, tooltip = TT_UNCONF, active = inEnableIndicator)

// 3. Precision Swing Point (PSP)
bool  inShowPspDot      = input.bool(true,       "Marker (◉)",    inline = "pspDot",  group = GRP_PSP, active = inEnableIndicator)
color inPspDotColor     = input.color(#2962FFFF, "",              inline = "pspDot",  group = GRP_PSP, active = ( inEnableIndicator and inShowPspDot ))
bool  inPreviewLivePsp  = input.bool(false,      "Live Intrabar", inline = "pspDot",  group = GRP_PSP, tooltip = TT_PSP_ROW, active = inEnableIndicator)

bool  inShowPspBarColor = input.bool(true,       "Color Candles", inline = "pspBars", group = GRP_PSP, active = inEnableIndicator)
color inBullPspBarColor = input.color(#00C853FF, "Bull",          inline = "pspBars", group = GRP_PSP, active = ( inEnableIndicator and inShowPspBarColor ))
color inBearPspBarColor = input.color(#FF1744FF, "Bear",          inline = "pspBars", group = GRP_PSP, tooltip = TT_PSP_BARS, active = ( inEnableIndicator and inShowPspBarColor ))


//====================================================================
// 1. ENGINE & DRAWING SETTINGS INITIALIZATION
//====================================================================

string trimmedSecondSymbol  = str.trim(inCustomSecondSymbol)
string trimmedThirdSymbol   = str.trim(inCustomThirdSymbol)
string resolvedSecondTicker = ( str.length(trimmedSecondSymbol) > 0 ) ? trimmedSecondSymbol : na
string resolvedThirdTicker  = ( str.length(trimmedThirdSymbol)  > 0 ) ? trimmedThirdSymbol  : na

var EngineLib.Settings EngineSettings = EngineLib.getSettingsInstance(
    enableSecondAsset  = inEnableSecond,
    enableThirdAsset   = inEnableThird,
    customSecondTicker = resolvedSecondTicker,
    customThirdTicker  = resolvedThirdTicker,
    maxBullishSmts     = inMaxBullish,
    maxBearishSmts     = inMaxBearish,
    previewLivePsp     = inPreviewLivePsp
)

var EngineLib.Engine Engine = EngineLib.getEngineInstance(EngineSettings)

var SmtLib.Settings BullishSmtSettings = SmtLib.Settings.new(
    ShowLine             = true,
    LineColor            = inBullishColor,
    UnconfirmedColor     = inUnconfirmedColor,
    LineStyle            = inConfirmedStyle,
    UnconfirmedLineStyle = inUnconfirmedStyle,
    LineWidth            = inLineWidth,
    ShowLabel            = inShowLabels,
    LabelColor           = #FFFFFF00,
    LabelTextColor       = inBullishColor,
    ShowPspLabel         = inShowPspDot,
    PspTextColor         = inPspDotColor
)

var SmtLib.Settings BearishSmtSettings = SmtLib.Settings.new(
    ShowLine             = true,
    LineColor            = inBearishColor,
    UnconfirmedColor     = inUnconfirmedColor,
    LineStyle            = inConfirmedStyle,
    UnconfirmedLineStyle = inUnconfirmedStyle,
    LineWidth            = inLineWidth,
    ShowLabel            = inShowLabels,
    LabelColor           = #FFFFFF00,
    LabelTextColor       = inBearishColor,
    ShowPspLabel         = inShowPspDot,
    PspTextColor         = inPspDotColor
)

if ( inEnableIndicator and barstate.isfirst )
    Engine.initializeTimeFrames(inShowHtf)


//====================================================================
// 2. DATA COLLECTION & RENDERING
//====================================================================

plot(close, display = display.none)

if ( inEnableIndicator )
    Engine.startMonitoringAssets()
    Engine.synchronizeSmtDrawings(BullishSmtSettings, BearishSmtSettings)

bool activePspBarColor = ( inEnableIndicator and inShowPspBarColor )
barcolor(activePspBarColor ? Engine.getPspBarColor(inBullPspBarColor, inBearPspBarColor)        : na, offset = -1, editable = false, show_last = 3)
barcolor(activePspBarColor ? Engine.getCurrentBarPspColor(inBullPspBarColor, inBearPspBarColor) : na,              editable = false, show_last = 1)
