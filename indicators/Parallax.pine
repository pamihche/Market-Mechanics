//@version=6
indicator("Parallax", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

import MihChe/HelperLibrary/1    as HelperLib
import MihChe/AssetLibrary/1     as AssetLib
import MihChe/TimeFrameLibrary/1 as TimeFrameLib
import MihChe/CandleLibrary/1    as CandleLib
import MihChe/SwingLibrary/1     as SwingLib
import MihChe/GapLibrary/1       as GapLib
import MihChe/SmtLibrary/1       as SmtLib
import MihChe/EngineLibrary/1    as EngineLib


//====================================================================
// INPUTS
//====================================================================

bool   inEnableSecond       = input.bool(true,      "Enable Second Asset",       group = "Assets")
bool   inEnableThird        = input.bool(true,      "Enable Third Asset",        group = "Assets")
string inCustomSecondTicker = input.string("",      "Custom Second Ticker",      group = "Assets")
string inCustomThirdTicker  = input.string("",      "Custom Third Ticker",       group = "Assets")

int    inMaxBullishSmts     = input.int(5,          "Max Bullish SMTs",          minval = 0, maxval = 5, group = "SMT Settings")
int    inMaxBearishSmts     = input.int(5,          "Max Bearish SMTs",          minval = 0, maxval = 5, group = "SMT Settings")
bool   inShowHtfSmt         = input.bool(true,      "Show HTF SMTs",             group = "SMT Settings")
color  inUnconfirmedColor   = input.color(#FF9800FF, "Unconfirmed SMT Color",    group = "SMT Settings")

bool   inShowPspDot         = input.bool(true,      "Show PSP Dot",              group = "PSP Settings")
color  inPspDotColor        = input.color(#2962FFFF, "PSP Dot Color",            group = "PSP Settings")
bool   inShowPspBarColor    = input.bool(true,      "Color PSP Candle",          group = "PSP Settings")
bool   inPreviewLivePsp     = input.bool(false,     "Preview Live Realtime PSP", group = "PSP Settings")
color  inBullPspBarColor    = input.color(#00C853FF, "Bullish PSP Candle",       group = "PSP Settings")
color  inBearPspBarColor    = input.color(#FF1744FF, "Bearish PSP Candle",       group = "PSP Settings")


//====================================================================
// 1. ENGINE & SMT DRAWINGS SETTINGS INITIALIZATION
//====================================================================

string resolvedSecondTicker = ( str.length(inCustomSecondTicker) > 0 ) ? inCustomSecondTicker : na
string resolvedThirdTicker  = ( str.length(inCustomThirdTicker)  > 0 ) ? inCustomThirdTicker  : na

var EngineLib.Settings EngineSettings = EngineLib.getSettingsInstance(
    enableSecondAsset  = inEnableSecond,
    enableThirdAsset   = inEnableThird,
    customSecondTicker = resolvedSecondTicker,
    customThirdTicker  = resolvedThirdTicker,
    maxBullishSmts     = inMaxBullishSmts,
    maxBearishSmts     = inMaxBearishSmts,
    previewLivePsp     = inPreviewLivePsp
)

var EngineLib.Engine Engine = EngineLib.getEngineInstance(EngineSettings)

var SmtLib.Settings BullishSmtSettings = SmtLib.Settings.new(
    ShowLine             = true,
    LineColor            = #089981FF,
    UnconfirmedColor     = inUnconfirmedColor,
    LineStyle            = SmtLib.LineStyleType.Solid,
    UnconfirmedLineStyle = SmtLib.LineStyleType.Solid,
    LineWidth            = 2,
    ShowLabel            = true,
    LabelColor           = #FFFFFF00,
    LabelTextColor       = #089981FF,
    ShowPspLabel         = inShowPspDot,
    PspTextColor         = inPspDotColor
)

var SmtLib.Settings BearishSmtSettings = SmtLib.Settings.new(
    ShowLine             = true,
    LineColor            = #F23645FF,
    UnconfirmedColor     = inUnconfirmedColor,
    LineStyle            = SmtLib.LineStyleType.Solid,
    UnconfirmedLineStyle = SmtLib.LineStyleType.Solid,
    LineWidth            = 2,
    ShowLabel            = true,
    LabelColor           = #FFFFFF00,
    LabelTextColor       = #F23645FF,
    ShowPspLabel         = inShowPspDot,
    PspTextColor         = inPspDotColor
)

if ( barstate.isfirst )
    Engine.initializeTimeFrames(inShowHtfSmt)


//====================================================================
// 2. RUN DATA COLLECTION & SMT SYNCHRONIZATION
//====================================================================

plot(close, display = display.none)

Engine.startMonitoringAssets()
Engine.synchronizeSmtDrawings(BullishSmtSettings, BearishSmtSettings)

barcolor(inShowPspBarColor ? Engine.getPspBarColor(inBullPspBarColor, inBearPspBarColor)  : na, offset = -1, editable = false, show_last = 3)
barcolor(inShowPspBarColor ? Engine.getCurrentBarPspColor(inBullPspBarColor, inBearPspBarColor) : na, editable = false, show_last = 1)
